# ==============================================================================
# Kawalo Mobile API - NPM Security & Deterministic Install Configuration
# ==============================================================================

# Supply-chain security: Mencegah eksekusi script lifecycle (preinstall, postinstall)
# secara otomatis dari package pihak ketiga saat `npm install`.
ignore-scripts=true

# Immutability & stability: Mengunci versi package secara eksak saat instalasi baru (tanpa ^ atau ~)
save-exact=true

# Keamanan otomatis: Selalu jalankan audit kerentanan CVE pada setiap proses instalasi
audit=true

# Deterministic dependencies: Selalu sinkronkan dan hormati package-lock.json
package-lock=true

# Enforce runtime constraints: Gagal jika versi Node.js / NPM tidak sesuai `engines` di package.json
engine-strict=true

# Output kebersihan: Nonaktifkan pesan funding/donasi npm
fund=false

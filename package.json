{
  "name": "kawalo-mobile-api",
  "version": "1.0.0",
  "description": "Enterprise-grade Backend API for Kawalo Mobile built with ElysiaJS, Prisma 8, and Bun",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:validate": "prisma validate",
    "prisma:migrate:baseline": "prisma migrate resolve --applied 0_init",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:deploy": "prisma migrate deploy && prisma generate",
    "auth:rotate-key": "tsx scripts/rotate-key.ts",
    "postinstall": "node scripts/patch-elysia.mjs"
  },
  "dependencies": {
    "@bogeychan/elysia-logger": "0.1.10",
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/node": "^1.4.5",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "elysia": "^1.4.30",
    "elysia-rate-limit": "4.6.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^22.20.2",
    "esbuild": "^0.28.2",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "mariadb": "^3.5.4",
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.24.0"
  }
}

{
  "name": "kawalo-mobile-api",
  "version": "1.0.0",
  "description": "Prisma migration tooling for the Kawalo Mobile API database (the API itself is Rust, see Cargo.toml)",
  "private": true,
  "type": "module",
  "scripts": {
    "prisma:validate": "prisma validate",
    "prisma:migrate:baseline": "prisma migrate resolve --applied 0_init",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "prisma": "^7.10.0"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.24.0"
  }
}

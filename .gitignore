# ==============================================================================
# Gitignore untuk Kawalo Mobile API (Rust: axum + sqlx + redis)
# ==============================================================================

# Build output
/target/

# Tooling Node (migrasi Prisma; tools/node_modules adalah symlink ke checkout oracle TypeScript)
node_modules

# Environment variables & secrets
.env
.env.*
!.env.example
!.env.*.example
certs/
data.sql

# Uploaded files
/uploads/
/face-photos/

# Logs
logs/
*.log

# IDEs & Editors
.idea/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Temporary files
*.tmp
*.temp
*.bak
*~

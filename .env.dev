# Kawalo Mobile API - Development Environment
NODE_ENV=development
PORT=3000
DATABASE_URL="mysql://root:@localhost:3306/kawalo"
DATABASE_USE_TEXT_PROTOCOL=false
REDIS_URL="redis://localhost:6379"
JWT_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_IN=1209600
CORS_ORIGIN="*"
RATE_LIMIT_MAX=100
RATE_LIMIT_DURATION=60000

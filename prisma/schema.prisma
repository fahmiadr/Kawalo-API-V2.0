generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model chatconversations {
  id                   BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  ms_user_email        String?        @db.VarChar(255)
  target_ms_email      String?        @db.VarChar(255)
  tk_user_id           Int?
  firebase_ref_id      String?        @unique(map: "chatconversations_firebase_ref_id_unique") @db.VarChar(255)
  last_message_preview String?        @db.Text
  created_at           DateTime       @default(now()) @db.Timestamp(0)
  updated_at           DateTime       @default(now()) @db.Timestamp(0)
  chatmessages         chatmessages[]

  @@unique([ms_user_email, target_ms_email], map: "uk_chat_ms_ms")
  @@unique([ms_user_email, tk_user_id], map: "uk_chat_ms_tk")
  @@index([ms_user_email], map: "chatconversations_ms_user_email_index")
  @@index([target_ms_email], map: "chatconversations_target_ms_email_index")
  @@index([tk_user_id], map: "chatconversations_tk_user_id_index")
}

model chatmessages {
  id                BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  conversation_id   BigInt?                  @db.UnsignedBigInt
  sender_type       chatmessages_sender_type
  sender_ref_id     String                   @db.VarChar(255)
  content           String                   @db.Text
  is_read           Boolean?                 @default(false)
  created_at        DateTime                 @default(now()) @db.Timestamp(0)
  updated_at        DateTime                 @default(now()) @db.Timestamp(0)
  chatconversations chatconversations?       @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "chatmessages_conversation_id_foreign")

  @@index([conversation_id], map: "chatmessages_conversation_id_foreign")
}

model knex_migrations {
  id             Int      @id @default(autoincrement()) @db.UnsignedInt
  name           String?  @db.VarChar(255)
  batch          Int?
  migration_time DateTime @default(now()) @db.Timestamp(0)
}

model knex_migrations_lock {
  index     Int  @id @default(autoincrement()) @db.UnsignedInt
  is_locked Int?
}


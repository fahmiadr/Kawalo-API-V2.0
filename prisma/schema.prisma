  GroupUID       String    @db.VarChar(64)
  AllowAdmin     String    @default("NO") @db.VarChar(5)
  AllowPatrol    String    @default("NO") @db.VarChar(5)
  Category       String    @default("USER") @db.VarChar(16)
  AllowMonPatrol String    @default("NO") @db.VarChar(5)
  Status         String    @default("JOIN_WAIT") @db.VarChar(12)
  JoinDate       DateTime? @default(now()) @db.DateTime(0)

  @@unique([GroupUID, Email], map: "UserUID")
  @@index([Email], map: "idx_tkusergroup_email")
}

model tkweeklyreport {

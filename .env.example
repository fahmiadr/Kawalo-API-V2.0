# ==============================================================================
# Kawalo Mobile API - Environment Variables Template
# Salin file ini menjadi .env.dev untuk environment development lokal:
#   cp .env.example .env.dev
# ==============================================================================

NODE_ENV=development
PORT=3000

# MariaDB / MySQL Database Connection
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/kawalo"
DATABASE_USE_TEXT_PROTOCOL=false

# Redis Cache & Real-time Session Store
REDIS_URL="redis://localhost:6379"

# Token Expiry (detik)
JWT_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_IN=1209600

# CORS & Security
CORS_ORIGIN="*"
RATE_LIMIT_MAX=100
RATE_LIMIT_DURATION=60000

